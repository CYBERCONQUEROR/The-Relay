# ==============================================================================
# The Relay - Environment Configuration Template
# ==============================================================================

# Groq API Configuration
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TIMEOUT=45.0

# LLM Client Resilience & Retry Settings
GROQ_MAX_ATTEMPTS=3
GROQ_INITIAL_BACKOFF=2.0
GROQ_MAX_BACKOFF=30.0
GROQ_MAX_SERVER_WAIT=30.0

# Retrieval Configuration
# Options for RETRIEVAL_SETTING: R1 (FAISS), R2 (Filtered), R3 (MMR), R4 (Hybrid RRF), R5 (Cross-Encoder)
RETRIEVAL_SETTING="R4"
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=50
MIN_RETRIEVAL_SCORE=0.25

# Evaluation Harness Settings
EVALUATION_DELAY_SECONDS=45

