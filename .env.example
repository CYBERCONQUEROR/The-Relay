# ==============================================================================
# The Relay - Environment Configuration Template
# ==============================================================================

# Groq API Configuration
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TIMEOUT=45.0

# LLM Client Resilience & Retry Settings
GROQ_MAX_ATTEMPTS=3
GROQ_INITIAL_BACKOFF=2.0
GROQ_MAX_BACKOFF=30.0
GROQ_MAX_SERVER_WAIT=30.0

# Retrieval Configuration
# Options for RETRIEVAL_SETTING: R1 (FAISS), R2 (Filtered), R3 (MMR), R4 (Hybrid RRF), R5 (Cross-Encoder)
RETRIEVAL_SETTING="R4"
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=50
MIN_RETRIEVAL_SCORE=0.25

# Evaluation Harness Settings
EVALUATION_DELAY_SECONDS=45


# Durable real-provider queue (not the simulator queue)
QUEUE_DATABASE=data/relay.sqlite3
QUEUE_CAPACITY=200
QUEUE_WORKERS=1
QUEUE_POLL_SECONDS=1
QUEUE_LEASE_SECONDS=120
QUEUE_MAX_ATTEMPTS=5
QUEUE_QUOTA_FALLBACK_SECONDS=86400
QUEUE_RETRY_SECONDS=30
# Default: worker inside FastAPI lifespan. Set false for a separate worker process.
QUEUE_INLINE_WORKER=true

# Single-operator access. Empty token allowed ONLY for loopback clients in local mode.
# Set a strong token and RELAY_LOCAL_MODE=false for any shared deployment.
RELAY_LOCAL_MODE=true
RELAY_ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STANDIN_URL=http://127.0.0.1:8002

# Controlled live experiments are OFF unless explicitly enabled AND confirmed.
GROQ_LOAD_TEST_ENABLED=false
GROQ_LOAD_TEST_MAX_REQUESTS=20
GROQ_LOAD_TEST_MAX_CONCURRENCY=2
GROQ_LOAD_TEST_MAX_TOKENS=10000
GROQ_LOAD_TEST_MAX_RUNTIME_SECONDS=300
